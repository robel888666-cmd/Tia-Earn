
# ==========================================
# TIA EARN - ENVIRONMENT CONFIGURATION
# File: .env.example
# ==========================================

# ------------------------------------------
# APPLICATION
# ------------------------------------------

NODE_ENV=production

PORT=3000

# Number of trusted reverse proxies.
# 0 = no trusted proxy.
# Change only according to your hosting setup.
TRUST_PROXY=0


# ------------------------------------------
# TELEGRAM BOT
# ------------------------------------------

# Get this from Telegram @BotFather.
# Never publish your real bot token.

BOT_TOKEN=REPLACE_WITH_YOUR_TELEGRAM_BOT_TOKEN

# Telegram bot username without @
# Example: TiaEarnBot

BOT_USERNAME=REPLACE_WITH_YOUR_BOT_USERNAME


# ------------------------------------------
# ADMIN ACCESS
# ------------------------------------------

# Numeric Telegram user IDs.
# Multiple IDs must be separated by commas.
# Example: 123456789,987654321

ADMIN_TELEGRAM_IDS=REPLACE_WITH_ADMIN_TELEGRAM_ID


# ------------------------------------------
# POSTGRESQL DATABASE
# ------------------------------------------

# Database connection string from your
# PostgreSQL hosting provider.

DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME

# true = require TLS with certificate validation.
# false = do not enable TLS through this setting.
# Production normally requires TLS.

DATABASE_SSL=true


# ------------------------------------------
# SESSION SECURITY
# ------------------------------------------

# Generate a long, random secret.
# Use at least 32 characters.
# Never reuse your Telegram bot token.

SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS


# ------------------------------------------
# NOTES
# ------------------------------------------

# The current server.js does not read
# separate ad network secrets, payment
# provider keys, or CORS settings.
#
# Do not add real provider credentials
# until their secure backend integrations
# have been implemented.
#
# Keep actual secrets in your hosting
# provider's Environment Variables.
#
# Never commit a real .env file.
